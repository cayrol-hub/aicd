{
    "name": "@aicd-ci/cli",
    "version": "1.0.2",
    "description": "aicd command line",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/cayrol-hub/aicd.git",
        "directory": "packages/cli"
    },
    "engines": {
        "node": ">=22.13"
    },
    "dependencies": {
        "@aicd-ci/adapter-ci-github": "workspace:*",
        "@aicd-ci/adapter-ci-gitlab": "workspace:*",
        "@aicd-ci/adapter-ci-local": "workspace:*",
        "@aicd-ci/adapter-deployers": "workspace:*",
        "@aicd-ci/adapter-issue-trackers": "workspace:*",
        "@aicd-ci/adapter-llm-anthropic": "workspace:*",
        "@aicd-ci/adapter-llm-openai": "workspace:*",
        "@aicd-ci/adapter-metrics-sources": "workspace:*",
        "@aicd-ci/adapter-notifiers": "workspace:*",
        "@aicd-ci/adapter-state-postgres": "workspace:*",
        "@aicd-ci/adapter-state-sqlite": "workspace:*",
        "@aicd-ci/agent-flaky": "workspace:*",
        "@aicd-ci/agent-intent-check": "workspace:*",
        "@aicd-ci/agent-pipeline-optimizer": "workspace:*",
        "@aicd-ci/agent-postmortem": "workspace:*",
