        "@aicd-ci/agent-release-notes": "workspace:*",
        "@aicd-ci/agent-risk-score": "workspace:*",
        "@aicd-ci/agent-security-triage": "workspace:*",
        "@aicd-ci/agent-test-selection": "workspace:*",
        "@aicd-ci/agent-triage": "workspace:*",
        "@aicd-ci/core": "workspace:*",
        "@aicd-ci/git": "workspace:*",
        "@aicd-ci/mcp": "workspace:*",
        "@aicd-ci/metrics": "workspace:*",
        "@aicd-ci/parsers": "workspace:*",
        "@aicd-ci/plugin-sdk": "workspace:*",
        "@aicd-ci/redaction": "workspace:*",
        "@aicd-ci/replay": "workspace:*",
        "@aicd-ci/server": "workspace:*",
        "commander": "^15.0.0",
        "tinyglobby": "^0.2.17",
        "yaml": "^2.9.1"
